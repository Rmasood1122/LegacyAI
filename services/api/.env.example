# LegacyAI API - example configuration for LOCAL DEVELOPMENT ONLY.
#
# Copy to .env (which is git-ignored) and run `npm run dev`.
# EVERY VALUE BELOW IS A FAKE PLACEHOLDER. They only work with the throwaway database
# started by `docker compose up -d`. Never use them anywhere else, and never put a real
# secret in this file. In the cloud these values come from Secret Manager.
#
# Generate real keys with:   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# The API connects as legacyai_app: no superuser, no BYPASSRLS. It refuses to start otherwise.
DATABASE_URL=postgres://legacyai_app:local-dev-app-password@127.0.0.1:55432/legacyai

# Used only by `npm run db:*` (roles + migrations). NOT read by the running API.
DATABASE_URL_SUPERUSER=postgres://postgres:local-dev-only-not-a-secret@127.0.0.1:55432/legacyai
DATABASE_URL_ADMIN=postgres://legacyai_migrator:local-dev-migrator-password@127.0.0.1:55432/legacyai
DATABASE_URL_BACKUP=postgres://legacyai_backup:local-dev-backup-password@127.0.0.1:55432/legacyai

# Pepper for the 3-digit secret code. JSON keyring; "current" names the key used for new hashes.
# Rotation: add "v2", set current to "v2", keep "v1" until no card uses it.
SC_PEPPER_KEYRING={"current":"v1","keys":{"v1":"RkFLRS1QRVBQRVItRE8tTk9ULVVTRS1GQUtFLVBFUFBFUi0="}}

# Encrypts authenticator-app seeds at rest. Keys must be exactly 32 bytes (base64).
CREDENTIAL_ENC_KEYRING={"current":"k1","keys":{"k1":"RkFLRS1FTkMtS0VZLURPLU5PVC1VU0UtRkFLRS1LRVk="}}

# Keys the one-way fingerprints of IP addresses and card numbers in rate-limit and attempt tables.
HMAC_INDEX_KEY=RkFLRS1ITUFDLUtFWS1ETy1OT1QtVVNFLUZBS0UtSE1BQy0=

# Shared secret for service-to-service calls (the AI service, Phase 2). At least 32 characters.
INTERNAL_SERVICE_TOKEN=fake-internal-token-do-not-use-0000000000

# Passkeys: the site name (no scheme, no port) and the exact origins allowed to call the API.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=LegacyAI (local)
ALLOWED_ORIGINS=http://localhost:3000

# Optional tuning. Values below the OWASP minimum (19456 KiB, 2 iterations) are rejected at start-up.
# ARGON2_MEMORY_KIB=19456
# ARGON2_ITERATIONS=2
# ARGON2_PARALLELISM=1
# ARGON2_MAX_CONCURRENCY=4
# DB_POOL_MAX=5
# TRUST_PROXY=false        # set to true on Cloud Run so the real client address is used
# EXPORT_DIR=./exports
