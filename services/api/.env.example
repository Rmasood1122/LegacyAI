# LegacyAI API - example configuration for LOCAL DEVELOPMENT ONLY.
#
# Copy to .env (which is git-ignored) and run `npm run dev`.
# EVERY VALUE BELOW IS A FAKE PLACEHOLDER. They only work with the throwaway database
# started by `docker compose up -d`. Never use them anywhere else, and never put a real
# secret in this file. In the cloud these values come from Secret Manager.
#
# Generate real keys with:   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# The API connects as legacyai_app: no superuser, no BYPASSRLS. It refuses to start otherwise.
DATABASE_URL=postgres://legacyai_app:local-dev-app-password@127.0.0.1:55432/legacyai

# Used only by `npm run db:*` (roles + migrations). NOT read by the running API.
DATABASE_URL_SUPERUSER=postgres://postgres:local-dev-only-not-a-secret@127.0.0.1:55432/legacyai
DATABASE_URL_ADMIN=postgres://legacyai_migrator:local-dev-migrator-password@127.0.0.1:55432/legacyai
DATABASE_URL_BACKUP=postgres://legacyai_backup:local-dev-backup-password@127.0.0.1:55432/legacyai
# The Python service's login (Phase 2). Only its password is used here, to create the role.
DATABASE_URL_AI=postgres://legacyai_ai:local-dev-ai-svc-password@127.0.0.1:55432/legacyai

# Pepper for the 3-digit secret code. JSON keyring; "current" names the key used for new hashes.
# Rotation: add "v2", set current to "v2", keep "v1" until no card uses it.
SC_PEPPER_KEYRING={"current":"v1","keys":{"v1":"RkFLRS1QRVBQRVItRE8tTk9ULVVTRS1GQUtFLVBFUFBFUi0="}}

# Encrypts authenticator-app seeds at rest. Keys must be exactly 32 bytes (base64).
CREDENTIAL_ENC_KEYRING={"current":"k1","keys":{"k1":"RkFLRS1FTkMtS0VZLURPLU5PVC1VU0UtRkFLRS1LRVk="}}

# Keys the one-way fingerprints of IP addresses and card numbers in rate-limit and attempt tables.
HMAC_INDEX_KEY=RkFLRS1ITUFDLUtFWS1ETy1OT1QtVVNFLUZBS0UtSE1BQy0=

# Shared secret for service-to-service calls (the AI service, Phase 2). At least 32 characters.
# Signs the short-lived tokens the API gives the AI service. The AI service is configured with the same value.
SERVICE_TOKEN_KEY=fake-service-token-key-do-not-use-000000
# The private AI service (plain http only for localhost).
AI_SERVICE_URL=http://127.0.0.1:8090

# Passkeys: the site name (no scheme, no port) and the exact origins allowed to call the API.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=LegacyAI (local)
ALLOWED_ORIGINS=http://localhost:3000

# Optional tuning. Values below the OWASP minimum (19456 KiB, 2 iterations) are rejected at start-up.
# ARGON2_MEMORY_KIB=19456
# ARGON2_ITERATIONS=2
# ARGON2_PARALLELISM=1
# ARGON2_MAX_CONCURRENCY=4
# DB_POOL_MAX=5
# TRUST_PROXY=false        # number of proxies in front of the API (Cloud Run: 1). Never "true".
# EXPORT_DIR=./exports
# WEB_DIST_DIR=../../web/dist   # the built web application; unset = the API serves no files at all
# The payment key below is a FAKE value (it decodes to text starting with "FAKE-") and is refused in production.
# With PAYMENT_PROVIDER unset no provider message is accepted at all, whatever key is set.
# PAYMENT_PROVIDER=none          # none (default) | fake (takes no money; accepted only when NODE_ENV=test)
# PAYMENT_EVENT_KEY=RkFLRS1wYXltZW50LWV2ZW50LWtleS1mb3ItbG9jYWwtdGVzdHMtb25seQ==   # FAKE value; base64, 32+ bytes
# Outgoing webhooks (docs/phase4/06): none (default) = endpoints can be registered, nothing is sent | https = the
# delivery job (npm run outbound:deliver, also part of housekeeping) sends signed messages to public https addresses.
# WEBHOOK_DELIVERY=none
# E-mail of notices: none (default) = nothing is queued or sent | fake = sends nothing (accepted only when NODE_ENV=test)
# | resend = Resend (D36; docs/phase4/06 part C). With resend: a sending-only key from the founder's Resend account (in
# Secret Manager, never in a file) and a sender address on a domain verified in Resend. The key below is FAKE.
# MAIL_SENDER=none
# MAIL_FROM=LegacyAI <no-reply@localhost>
# RESEND_API_KEY=re_FAKE_placeholder_not_a_key
# SSO (docs/phase4/07): where a company's identity provider sends people back. Each company registers its own
# address under it (this + /<company id>) at its provider. Default: the first ALLOWED_ORIGINS entry + /sso/return.
# SSO_REDIRECT_URI=http://localhost:3000/sso/return
# Bring-your-own-key (feature 21, docs/phase4/08-bring-your-own-key.md): the service that holds companies' own
# encryption keys. none = no company can bring a key (default). local = keys from LOCAL_KEY_SERVICE_KEYS - a stand-in
# for tests and development, refused when NODE_ENV=production. The value below is a fake placeholder, not a key.
# KEY_SERVICE=none
# LOCAL_KEY_SERVICE_KEYS={"demo":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}
