{
  "name": "@legacyai/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "generate": "node scripts/generate-api.mjs",
    "generate:check": "node scripts/generate-api.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "vite build && node scripts/check-build.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@simplewebauthn/browser": "13.3.0",
    "@tanstack/react-query": "5.101.4",
    "react": "19.0.8",
    "react-dom": "19.0.8",
    "react-router": "7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "24.19.0",
    "@types/react": "19.0.14",
    "@types/react-dom": "19.0.6",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.11.0",
    "jsdom": "30.0.1",
    "playwright-core": "1.62.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.2.0",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  }
}
